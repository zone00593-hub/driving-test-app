{
  "name": "driving-test-app",
  "version": "1.0.0",
  "private": true,
  "description": "汽車駕照筆試練習網站：完整題庫背題、限時模擬考、錯題本、雲端同步（Vite + TypeScript + Supabase）",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
